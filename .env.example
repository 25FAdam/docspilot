# Copy to .env (gitignored) and put real values there. Never commit secrets.
# app/config.py is the source of truth for defaults; values below mirror them.

GOOGLE_API_KEY=
DATABASE_URL=postgresql://docspilot:docspilot@localhost:5432/docspilot
ROUTER_MODEL=gemini-2.5-flash-lite
SYNTH_MODEL=gemini-2.5-flash
RETRIEVAL_THRESHOLD=0.35
DAILY_REQUEST_CAP=200
MAX_OUTPUT_TOKENS=1024
