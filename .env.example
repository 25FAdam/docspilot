# Get a free API key at https://aistudio.google.com/apikey (Google AI Studio)
GOOGLE_API_KEY=
DATABASE_URL=postgresql://docspilot:docspilot@127.0.0.1:5432/docspilot
ROUTER_MODEL=gemini-2.5-flash-lite
SYNTH_MODEL=gemini-2.5-flash
RETRIEVAL_THRESHOLD=0.35
DAILY_REQUEST_CAP=200
MAX_OUTPUT_TOKENS=1024

# --- Local Postgres (docker compose reads these; POSTGRES_PASSWORD is required) ---
# Keep DATABASE_URL consistent with the three values below.
POSTGRES_USER=docspilot
POSTGRES_PASSWORD=docspilot
POSTGRES_DB=docspilot

# --- Embeddings (local fastembed model; changing the model re-embeds everything; changing
# EMBEDDING_DIM also requires `DROP TABLE chunks` because the column type is fixed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBED_BATCH_SIZE=64

# --- Handbook source (downloaded via the GitLab API into RAW_DATA_DIR, gitignored) ---
HANDBOOK_PROJECT=gitlab-com/content-sites/handbook
HANDBOOK_REF=main
# Comma-separated repo paths. Only .md files are downloaded.
HANDBOOK_PATHS=content/handbook/engineering,content/handbook/people-group/general-onboarding
# Total cap on downloaded files across ALL paths. The budget is shared fairly: paths are
# visited from smallest to largest, each gets remaining_budget // remaining_paths files, and
# unused budget flows to the larger paths. Within a path, files are picked at evenly spaced
# positions in sorted-path order (so every subtree is represented). Deterministic.
HANDBOOK_MAX_FILES_TOTAL=300
HANDBOOK_BASE_URL=https://handbook.gitlab.com
RAW_DATA_DIR=data/raw

# --- Chunking (tokens counted with the embedding model's tokenizer; max includes the breadcrumb) ---
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_RATIO=0.12

# --- HTTP (429/5xx are retried with exponential backoff) ---
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
